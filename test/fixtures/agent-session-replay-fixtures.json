{
  "version": 1,
  "normalization": {
    "workspace": "<workspace>",
    "timestamps": "logical-seq",
    "ids": "fixture-stable"
  },
  "scenarios": [
    {
      "id": "task-a-skill-verification",
      "request": { "message": "Verify the skill file and report only observed facts.", "workspace": "<workspace>" },
      "modelResponses": [{ "provider": "replay", "requestId": "model-task-a-1", "text": "The file was read and the facts are reported." }],
      "toolCalls": [{ "id": "tool-task-a-read", "name": "file_read", "input": { "path": "<workspace>/agent/skills/skill-verification/SKILL.md" }, "output": "name: skill-verification\ndescription: verify trusted skill context" }],
      "events": [
        { "version": 1, "type": "turn.started", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 1, "timestamp": 1 },
        { "version": 1, "type": "thinking.delta", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 2, "timestamp": 2, "messageSeq": 1, "contentIndex": 0, "phase": "start", "text": "Read" },
        { "version": 1, "type": "tool.started", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 3, "timestamp": 3, "toolCallId": "tool-task-a-read", "name": "file_read", "input": { "path": "<workspace>/agent/skills/skill-verification/SKILL.md" } },
        { "version": 1, "type": "tool.completed", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 4, "timestamp": 4, "toolCallId": "tool-task-a-read", "name": "file_read", "output": "name: skill-verification\ndescription: verify trusted skill context", "evidenceFields": ["content"] },
        { "version": 1, "type": "thinking.delta", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 5, "timestamp": 5, "messageSeq": 1, "contentIndex": 0, "phase": "end", "text": "" },
        { "version": 1, "type": "content.delta", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 6, "timestamp": 6, "messageSeq": 1, "contentIndex": 1, "phase": "start", "text": "Observed facts" },
        { "version": 1, "type": "content.delta", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 7, "timestamp": 7, "messageSeq": 1, "contentIndex": 1, "phase": "delta", "text": " only." },
        { "version": 1, "type": "content.delta", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 8, "timestamp": 8, "messageSeq": 1, "contentIndex": 1, "phase": "end", "text": "" },
        { "version": 1, "type": "turn.completed", "sessionId": "session-task-a", "turnId": "turn-task-a", "seq": 9, "timestamp": 9 }
      ],
      "sessionJsonl": [
        { "type": "session", "id": "session-task-a" },
        { "type": "message", "id": "user-task-a", "message": { "role": "user", "content": [{ "type": "text", "text": "Verify the skill file and report only observed facts." }] } },
        { "type": "message", "id": "assistant-task-a", "turnId": "turn-task-a", "message": { "role": "assistant", "content": [] } }
      ],
      "expected": { "terminal": "done", "text": "Observed facts only.", "blockTypes": ["thinking", "tool", "text"] }
    },
    {
      "id": "skill-facts-verification",
      "request": { "message": "Read skill facts and report trust, enabled and parse.", "workspace": "<workspace>" },
      "modelResponses": [{ "provider": "replay", "requestId": "model-facts-1", "text": "trust=trusted enabled=true parse=valid" }],
      "toolCalls": [{ "id": "tool-facts-read", "name": "skill_facts", "input": { "id": "skill-verification" }, "output": "trust=trusted enabled=true parse=valid" }],
      "events": [
        { "version": 1, "type": "turn.started", "sessionId": "session-facts", "turnId": "turn-facts", "seq": 1, "timestamp": 1 },
        { "version": 1, "type": "tool.started", "sessionId": "session-facts", "turnId": "turn-facts", "seq": 2, "timestamp": 2, "toolCallId": "tool-facts-read", "name": "skill_facts", "input": { "id": "skill-verification" } },
        { "version": 1, "type": "tool.completed", "sessionId": "session-facts", "turnId": "turn-facts", "seq": 3, "timestamp": 3, "toolCallId": "tool-facts-read", "name": "skill_facts", "output": "trust=trusted enabled=true parse=valid", "evidenceFields": ["trust", "enabled", "parse"] },
        { "version": 1, "type": "content.delta", "sessionId": "session-facts", "turnId": "turn-facts", "seq": 4, "timestamp": 4, "messageSeq": 1, "contentIndex": 0, "phase": "start", "text": "trust=trusted" },
        { "version": 1, "type": "content.delta", "sessionId": "session-facts", "turnId": "turn-facts", "seq": 5, "timestamp": 5, "messageSeq": 1, "contentIndex": 0, "phase": "delta", "text": " enabled=true parse=valid" },
        { "version": 1, "type": "content.delta", "sessionId": "session-facts", "turnId": "turn-facts", "seq": 6, "timestamp": 6, "messageSeq": 1, "contentIndex": 0, "phase": "end", "text": "" },
        { "version": 1, "type": "turn.completed", "sessionId": "session-facts", "turnId": "turn-facts", "seq": 7, "timestamp": 7 }
      ],
      "sessionJsonl": [
        { "type": "session", "id": "session-facts" },
        { "type": "message", "id": "user-facts", "message": { "role": "user", "content": [{ "type": "text", "text": "Read skill facts and report trust, enabled and parse." }] } },
        { "type": "message", "id": "assistant-facts", "turnId": "turn-facts", "message": { "role": "assistant", "content": [] } }
      ],
      "expected": { "terminal": "done", "text": "trust=trusted enabled=true parse=valid", "blockTypes": ["tool", "text"] }
    },
    {
      "id": "tool-failure-retry",
      "request": { "message": "Read the target, retry once after a transport failure, then answer.", "workspace": "<workspace>" },
      "modelResponses": [{ "provider": "replay", "requestId": "model-retry-1", "text": "Retry succeeded." }],
      "toolCalls": [
        { "id": "tool-retry-first", "name": "file_read", "input": { "path": "<workspace>/missing.txt" }, "error": { "code": "not_found", "message": "missing" } },
        { "id": "tool-retry-second", "name": "file_read", "input": { "path": "<workspace>/target.txt" }, "output": "retry result" }
      ],
      "events": [
        { "version": 1, "type": "turn.started", "sessionId": "session-retry", "turnId": "turn-retry", "seq": 1, "timestamp": 1 },
        { "version": 1, "type": "tool.started", "sessionId": "session-retry", "turnId": "turn-retry", "seq": 2, "timestamp": 2, "toolCallId": "tool-retry-first", "name": "file_read", "input": { "path": "<workspace>/missing.txt" } },
        { "version": 1, "type": "tool.failed", "sessionId": "session-retry", "turnId": "turn-retry", "seq": 3, "timestamp": 3, "toolCallId": "tool-retry-first", "name": "file_read", "error": { "code": "not_found", "category": "storage", "retryable": true, "message": "missing" } },
        { "version": 1, "type": "turn.started", "sessionId": "session-retry", "turnId": "turn-retry-2", "seq": 4, "timestamp": 4 },
        { "version": 1, "type": "tool.started", "sessionId": "session-retry", "turnId": "turn-retry-2", "seq": 5, "timestamp": 5, "toolCallId": "tool-retry-second", "name": "file_read", "input": { "path": "<workspace>/target.txt" } },
        { "version": 1, "type": "tool.completed", "sessionId": "session-retry", "turnId": "turn-retry-2", "seq": 6, "timestamp": 6, "toolCallId": "tool-retry-second", "name": "file_read", "output": "retry result", "evidenceFields": ["output"] },
        { "version": 1, "type": "content.delta", "sessionId": "session-retry", "turnId": "turn-retry-2", "seq": 7, "timestamp": 7, "messageSeq": 1, "contentIndex": 0, "phase": "start", "text": "Retry" },
        { "version": 1, "type": "content.delta", "sessionId": "session-retry", "turnId": "turn-retry-2", "seq": 8, "timestamp": 8, "messageSeq": 1, "contentIndex": 0, "phase": "delta", "text": " succeeded." },
        { "version": 1, "type": "content.delta", "sessionId": "session-retry", "turnId": "turn-retry-2", "seq": 9, "timestamp": 9, "messageSeq": 1, "contentIndex": 0, "phase": "end", "text": "" },
        { "version": 1, "type": "turn.completed", "sessionId": "session-retry", "turnId": "turn-retry-2", "seq": 10, "timestamp": 10 }
      ],
      "sessionJsonl": [
        { "type": "session", "id": "session-retry" },
        { "type": "message", "id": "user-retry", "message": { "role": "user", "content": [{ "type": "text", "text": "Read the target, retry once after a transport failure, then answer." }] } },
        { "type": "message", "id": "assistant-retry", "turnId": "turn-retry", "message": { "role": "assistant", "content": [] } },
        { "type": "message", "id": "assistant-retry-2", "turnId": "turn-retry-2", "message": { "role": "assistant", "content": [] } }
      ],
      "expected": { "terminal": "done", "text": "Retry succeeded.", "blockTypes": ["tool", "tool", "text"] }
    },
    {
      "id": "event-node-order",
      "request": { "message": "Stream thought, tool and final text in order.", "workspace": "<workspace>" },
      "modelResponses": [{ "provider": "replay", "requestId": "model-order-1", "text": "Final answer" }],
      "toolCalls": [{ "id": "tool-order", "name": "command", "input": { "command": "printf fixture" }, "output": "fixture" }],
      "events": [
        { "version": 1, "type": "turn.started", "sessionId": "session-order", "turnId": "turn-order", "seq": 1, "timestamp": 1 },
        { "version": 1, "type": "thinking.delta", "sessionId": "session-order", "turnId": "turn-order", "seq": 2, "timestamp": 2, "messageSeq": 1, "contentIndex": 0, "phase": "start", "text": "Think" },
        { "version": 1, "type": "thinking.delta", "sessionId": "session-order", "turnId": "turn-order", "seq": 3, "timestamp": 3, "messageSeq": 1, "contentIndex": 0, "phase": "end", "text": "" },
        { "version": 1, "type": "tool.started", "sessionId": "session-order", "turnId": "turn-order", "seq": 4, "timestamp": 4, "toolCallId": "tool-order", "name": "command", "input": { "command": "printf fixture" } },
        { "version": 1, "type": "tool.completed", "sessionId": "session-order", "turnId": "turn-order", "seq": 5, "timestamp": 5, "toolCallId": "tool-order", "name": "command", "output": "fixture", "evidenceFields": ["output"] },
        { "version": 1, "type": "content.delta", "sessionId": "session-order", "turnId": "turn-order", "seq": 6, "timestamp": 6, "messageSeq": 1, "contentIndex": 1, "phase": "start", "text": "Final" },
        { "version": 1, "type": "content.delta", "sessionId": "session-order", "turnId": "turn-order", "seq": 7, "timestamp": 7, "messageSeq": 1, "contentIndex": 1, "phase": "delta", "text": " answer" },
        { "version": 1, "type": "content.delta", "sessionId": "session-order", "turnId": "turn-order", "seq": 8, "timestamp": 8, "messageSeq": 1, "contentIndex": 1, "phase": "end", "text": "" },
        { "version": 1, "type": "turn.completed", "sessionId": "session-order", "turnId": "turn-order", "seq": 9, "timestamp": 9 }
      ],
      "sessionJsonl": [
        { "type": "session", "id": "session-order" },
        { "type": "message", "id": "user-order", "message": { "role": "user", "content": [{ "type": "text", "text": "Stream thought, tool and final text in order." }] } },
        { "type": "message", "id": "assistant-order", "turnId": "turn-order", "message": { "role": "assistant", "content": [] } }
      ],
      "expected": { "terminal": "done", "text": "Final answer", "blockTypes": ["thinking", "tool", "text"] }
    },
    {
      "id": "refresh-recovery",
      "request": { "message": "Recover the completed stream after refresh.", "workspace": "<workspace>" },
      "modelResponses": [{ "provider": "replay", "requestId": "model-refresh-1", "text": "Recovered answer" }],
      "toolCalls": [{ "id": "tool-refresh", "name": "file_read", "input": { "path": "<workspace>/result.txt" }, "output": "persisted" }],
      "events": [
        { "version": 1, "type": "turn.started", "sessionId": "session-refresh", "turnId": "turn-refresh", "seq": 1, "timestamp": 1 },
        { "version": 1, "type": "tool.started", "sessionId": "session-refresh", "turnId": "turn-refresh", "seq": 2, "timestamp": 2, "toolCallId": "tool-refresh", "name": "file_read", "input": { "path": "<workspace>/result.txt" } },
        { "version": 1, "type": "tool.completed", "sessionId": "session-refresh", "turnId": "turn-refresh", "seq": 3, "timestamp": 3, "toolCallId": "tool-refresh", "name": "file_read", "output": "persisted", "evidenceFields": ["output"] },
        { "version": 1, "type": "content.delta", "sessionId": "session-refresh", "turnId": "turn-refresh", "seq": 4, "timestamp": 4, "messageSeq": 1, "contentIndex": 0, "phase": "start", "text": "Recovered" },
        { "version": 1, "type": "content.delta", "sessionId": "session-refresh", "turnId": "turn-refresh", "seq": 5, "timestamp": 5, "messageSeq": 1, "contentIndex": 0, "phase": "delta", "text": " answer" },
        { "version": 1, "type": "content.delta", "sessionId": "session-refresh", "turnId": "turn-refresh", "seq": 6, "timestamp": 6, "messageSeq": 1, "contentIndex": 0, "phase": "end", "text": "" },
        { "version": 1, "type": "turn.completed", "sessionId": "session-refresh", "turnId": "turn-refresh", "seq": 7, "timestamp": 7 }
      ],
      "sessionJsonl": [
        { "type": "session", "id": "session-refresh" },
        { "type": "message", "id": "user-refresh", "message": { "role": "user", "content": [{ "type": "text", "text": "Recover the completed stream after refresh." }] } },
        { "type": "message", "id": "assistant-refresh", "turnId": "turn-refresh", "message": { "role": "assistant", "content": [] } }
      ],
      "expected": { "terminal": "done", "text": "Recovered answer", "blockTypes": ["tool", "text"] }
    }
  ]
}
