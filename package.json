{
  "name": "my-code-agent",
  "version": "0.1.0",
  "private": true,
  "author": "My Code Agent Contributors",
  "description": "基于 PI 架构的自定义 Code Agent — 桌面端为主，CLI 为辅",
  "type": "module",
  "main": "dist-electron/electron/electron-main.js",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "compile:frontend-ts": "node scripts/compile-frontend-ts.mjs",
    "cli": "tsx src/server/main.ts --cli",
    "build:vite": "node scripts/build-frontend.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/compile-preload.mjs",
    "typecheck:frontend": "tsc -p src/frontend/tsconfig.frontend.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p src/frontend/tsconfig.frontend.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json && node scripts/build-frontend.mjs",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:dir": "node scripts/dist-dir.mjs",
    "test": "npm run test:manifest && npm run test:unit && npm run test:routes && npm run test:frontend && node test/css-vars.mjs",
    "test:manifest": "node scripts/test-manifest.mjs --check",
    "test:parallel": "node scripts/test-parallel.mjs",
    "test:unit": "node scripts/test-suite.mjs unit",
    "test:routes": "node scripts/test-routes.mjs",
    "test:frontend": "node scripts/test-suite.mjs frontend",
    "test:smoke": "node test/smoke.mjs",
    "test:build": "node scripts/test-build.mjs",
    "test:dist-event-flow": "npm run test:build",
    "test:electron:e2e": "npm run build && node scripts/dist-dir.mjs --skip-build && npm run test:electron:e2e:run",
    "test:electron:e2e:run": "node test/packaged-electron.e2e.mjs",
    "test:provider:live": "node scripts/tsx-test.mjs --test test/provider-live-matrix.test.mjs",
    "capabilities:generate": "node --import tsx scripts/generate-capability-catalog.mjs",
    "capabilities:check": "node --import tsx scripts/generate-capability-catalog.mjs --check",
    "release:check": "node scripts/release-check.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "build": {
    "appId": "com.mycodeagent.desktop",
    "productName": "MyCodeAgent",
    "electronVersion": "39.8.10",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "node_modules/web-tree-sitter/web-tree-sitter.wasm",
        "to": "tree-sitter/web-tree-sitter.wasm"
      },
      {
        "from": "node_modules/tree-sitter-bash/tree-sitter-bash.wasm",
        "to": "tree-sitter/tree-sitter-bash.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MyCodeAgent-${version}.exe"
    },
    "asar": true
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@mdi/font": "^7.4.47",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xiamol/pi-coding-agent": "0.84.2-xiamol.0",
    "devicon": "^2.17.0",
    "happy-dom": "^20.10.6",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "source-map": "^0.7.6",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "chokidar": "^4.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  }
}
